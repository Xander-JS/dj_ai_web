# ==============================================================================
# SYSTEM DJ - VARIABLES DE ENTORNO DE EJEMPLO
# ==============================================================================

# Supabase Client Configuration (Frontend Web / Vite)
# NOTA: Solo incluir variables con prefijo VITE_ expuestas de forma segura al cliente.
# NUNCA incluir claves service_role ni secretos administrativos en este archivo.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Gemini API configuration (opcional; solo middleware local del servidor Vite dev)
# Esta clave no se usa en el bundle del cliente. El middleware de Vite no es un backend
# de producción; no configures esta variable en un hosting de archivos estáticos.
GEMINI_API_KEY=your_gemini_api_key_here

# Microservicio local de extracción de audio (server/, FastAPI + yt-dlp)
VITE_AUDIO_SERVICE_URL=http://localhost:8000
